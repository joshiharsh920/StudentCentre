<mvc:View
    controllerName="centralstudentcentre.controller.Student"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:l="sap.ui.layout"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="studentPage" title="Student Registration" titleAlignment="Center">
        <content>
            <VBox class="sapUiResponsiveContentPadding studentPageContent">
                <Panel
                    
                    expandable="false"
                    class="studentSectionPanel">
                    <content>
                        <l:Grid
                            defaultSpan="XL3 L4 M6 S12"
                            hSpacing="1"
                            vSpacing="0"
                            width="100%">
                    <VBox class="studentFormField">
                        <Label text="First Name" labelFor="firstNameInput" />
                        <Input id="firstNameInput" value="{firstName}" maxLength="100" width="100%" />
                    </VBox>
                    <VBox class="studentFormField">
                        <Label text="Last Name" labelFor="lastNameInput" />
                        <Input id="lastNameInput" value="{lastName}" maxLength="100" width="100%" />
                    </VBox>
                    <VBox class="studentFormField">
                        <Label text="Email" labelFor="emailInput" />
                        <Input id="emailInput" value="{email}" type="Email" maxLength="255" width="100%" />
                    </VBox>
                    <VBox class="studentFormField">
                        <Label text="Phone" labelFor="phoneInput" />
                        <Input id="phoneInput" value="{phone}" type="Tel" maxLength="15" width="100%" />
                    </VBox>
                    <VBox class="studentFormField">
                        <Label text="Date of Birth" labelFor="dateOfBirthInput" />
                        <DatePicker
                            id="dateOfBirthInput"
                            value="{dateOfBirth}"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="medium"
                            width="100%" />
                    </VBox>
                    <VBox class="studentFormField">
                        <Label text="Gender" labelFor="genderInput" />
                        <Input id="genderInput" value="{gender}" maxLength="20" width="100%" />
                    </VBox>
                    <VBox class="studentFormField">
                        <Label text="Country" labelFor="countryInput" />
                        <Input id="countryInput" value="{country_code}" maxLength="3" width="100%" />
                    </VBox>
                    <VBox class="studentFormField">
                        <Label text="Address" labelFor="addressInput" />
                        <Input
                            id="addressInput"
                            value="{address}"
                            maxLength="500"
                            width="100%" />
                    </VBox>
                        </l:Grid>
                    </content>
                </Panel>

                <Table
                    id="academicRecordsTable"
                    items="{path: 'academicRecords'}"
                    growing="true"
                    growingScrollToLoad="true"
                    sticky="ColumnHeaders,HeaderToolbar"
                    class="sapUiMediumMarginTop studentSectionTable"
                    noDataText="No academic records added yet">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="Academic Records" level="H2" />
                            <ToolbarSpacer />
                            <Button
                                text="Add"
                                icon="sap-icon://add"
                                type="Emphasized"
                                press=".onAddAcademicRecord" />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column width="11rem"><Text text="Qualification" /></Column>
                        <Column width="13rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Board" /></Column>
                        <Column width="16rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Institution" /></Column>
                        <Column width="9rem" minScreenWidth="Desktop" demandPopin="true" hAlign="End"><Text text="Passing Year" /></Column>
                        <Column width="10rem" minScreenWidth="Desktop" demandPopin="true" hAlign="End"><Text text="Obtained Marks" /></Column>
                        <Column width="10rem" minScreenWidth="Desktop" demandPopin="true" hAlign="End"><Text text="Maximum Marks" /></Column>
                        <Column width="8rem" minScreenWidth="Tablet" demandPopin="true" hAlign="End"><Text text="Percentage" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ComboBox
                    width="100%"
                    selectedKey="{qualification}"
                    items="{
                        path: '/Qualifications',
                        parameters: {
                            $select: 'code,name',
                            $orderby: 'name'
                        }
                    }">

                    <core:Item
                        key="{code}"
                        text="{name}" />
                </ComboBox>
                                <ComboBox
                                    width="100%"
                                    selectedKey="{board}"
                                    items="{
                                        path: '/Boards',
                                        parameters: {
                                            $select: 'bcode,name',
                                            $orderby: 'name'
                                        }
                                    }">
                                    <core:Item key="{bcode}" text="{name}" />
                                </ComboBox>
                                <Input value="{institution}" maxLength="200" />
                                <Input value="{passingYear}" type="Number" textAlign="End" />
                                <Input value="{obtainedMarks}" type="Number" textAlign="End" />
                                <Input value="{maximumMarks}" type="Number" textAlign="End" />
                                <Input value="{percentage}" type="Number" textAlign="End" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>

        </content>
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button id="submitButton" text="Submit" type="Emphasized" press=".onSubmit" />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
